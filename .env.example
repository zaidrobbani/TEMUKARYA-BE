# ===== Aplikasi =====
APP_NAME=TEMUKARYA API
APP_ENV=development
DEBUG=true
API_PORT=8000

# ===== Database (MySQL) =====
# DB_HOST dipakai saat menjalankan API di luar Docker.
# Di dalam Docker Compose otomatis dioverride jadi "db".
DB_HOST=localhost
DB_PORT=3306
DB_NAME=temukarya
DB_USER=temukarya
DB_PASSWORD=temukarya_secret
DB_ROOT_PASSWORD=root_secret

# Port MySQL yang dibuka ke host. Ganti (misal 3307) kalau 3306 sudah dipakai MySQL lokal.
DB_HOST_PORT=3306

# Jalankan "alembic upgrade head" otomatis saat container API start
RUN_MIGRATIONS=true
