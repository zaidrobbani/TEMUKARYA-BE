# Template .env untuk server produksi. Salin ke .env di server, lalu ganti semua nilai GANTI_*.
# Panduan: docs/deploy.md

# Supaya `docker compose ...` di server otomatis memakai file produksi.
COMPOSE_FILE=docker-compose.prod.yml
# Isi `mailpit` kalau memakai Mailpit sebagai pengganti SMTP asli.
COMPOSE_PROFILES=

APP_NAME=TEMUKARYA API
APP_ENV=production
DEBUG=false
API_PORT=8000
HTTP_PORT=80

# Ganti ke mysql:8.0-debian kalau log db berisi "CPU does not support x86-64-v2".
MYSQL_IMAGE=mysql:8.4

DB_HOST=db
DB_PORT=3306
DB_NAME=temukarya
DB_USER=temukarya
DB_PASSWORD=GANTI_openssl_rand_hex_24
DB_ROOT_PASSWORD=GANTI_openssl_rand_hex_24
DB_HOST_PORT=3306

RUN_MIGRATIONS=true

JWT_SECRET_KEY=GANTI_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Dipakai untuk tautan verifikasi email & reset password.
PUBLIC_BASE_URL=https://temukarya.bccdev.id

# SMTP asli (contoh Gmail + App Password). Kalau belum ada, lihat bagian Mailpit di docs/deploy.md.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=GANTI_alamat_gmail
SMTP_PASSWORD=GANTI_app_password_16_huruf
SMTP_USE_TLS=true
EMAIL_FROM="TEMUKARYA <GANTI_alamat_gmail>"

# Harus sama dengan Web client ID yang dipakai Android untuk Google Sign-In.
GOOGLE_CLIENT_ID=

# File di-upload ke folder secrets/ di server (di-mount read-only ke /app/secrets).
FIREBASE_CREDENTIALS_FILE=/app/secrets/firebase-service-account.json
